---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';
import CTASection from '../components/CTASection.astro';
import closetRack from '../assets/alyssa-strohmann-TS--uNw-JqE-unsplash.jpg';
---

<Layout title="Pricing" description="Thoughtful, quote-based pricing for home organization projects of every size. Serving the Greater Tacoma Area.">

  <!-- ===== PAGE HEADER ===== -->
  <section class="bg-cream pt-20 pb-12 md:pt-28 md:pb-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="font-cormorant text-lg italic text-gold mb-2 block reveal">Transparent pricing</span>
      <h1 class="font-playfair text-4xl md:text-5xl lg:text-6xl text-warm-dark leading-[1.1] mb-6 reveal stagger-1">
        Investment
      </h1>
      <p class="text-lg text-warm max-w-2xl mx-auto reveal stagger-2">
        Every home and every project is different. We'll talk through your space, your goals, and the support you need before putting together a quote.
      </p>
    </div>
  </section>

  <SectionDivider variant="curve" toColor="#FFFFFF" />

  <!-- ===== QUOTE MESSAGE ===== -->
  <section class="bg-white py-24 md:py-32">
    <div class="max-w-6xl mx-auto px-6">
      <div class="relative max-w-4xl mx-auto text-center reveal">
        <div class="absolute inset-0 rounded-[2rem] bg-gradient-to-br from-gold/20 via-cream to-terracotta/10 blur-2xl opacity-70"></div>
        <div class="relative overflow-hidden rounded-[2rem] bg-cream border border-gold-light/40 px-8 py-14 md:px-16 md:py-20 shadow-xl shadow-warm-dark/10">
          <div class="absolute top-0 left-1/2 h-1 w-28 -translate-x-1/2 rounded-b-full bg-gradient-to-r from-gold to-terracotta"></div>
          <span class="font-cormorant text-xl italic text-gold mb-4 block">Personalized quotes</span>
          <h2 class="font-playfair text-3xl md:text-5xl text-warm-dark leading-tight mb-6">
            Support for big resets and small projects alike.
          </h2>
          <p class="text-lg md:text-xl text-warm leading-relaxed max-w-2xl mx-auto">
            I love helping with projects of every size. Once we've got a clear picture of your space, your goals, and the project scope, I'll send over a thoughtful quote so we can start restoring order back to your home.
          </p>
          <a href="/contact#contact-form" class="inline-flex items-center justify-center mt-10 rounded-full bg-terracotta px-8 py-4 text-sm font-semibold uppercase tracking-[0.18em] text-white shadow-lg shadow-terracotta/20 transition-all duration-300 hover:bg-terracotta-dark hover:-translate-y-0.5">
            Start With a Free Consultation
          </a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider variant="wave2" toColor="#FBF7F2" />

  <!-- ===== WHAT'S INCLUDED ===== -->
  <section class="bg-cream py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-14">
        <span class="font-cormorant text-lg italic text-gold mb-2 block reveal">Every session includes</span>
        <h2 class="font-playfair text-3xl md:text-4xl text-warm-dark mb-8 reveal stagger-1">
          What's Included
        </h2>
        <div class="mx-auto max-w-xs aspect-[3/2] rounded-xl overflow-hidden shadow-lg shadow-warm-dark/10 reveal stagger-2">
          <Image
            src={closetRack}
            alt="A beautifully curated closet with warm-toned clothing"
            class="w-full h-full object-cover"
            widths={[300, 500]}
            sizes="320px"
            quality={60}
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto mb-14">
        {[
          'Free consultation',
          'Hands-on organizing support',
          'Light cleaning as needed',
          'Labels included',
          'Personalized product recommendations',
          'Judgment-free environment',
        ].map((item, i) => (
          <div class:list={['flex items-center gap-3 bg-white rounded-xl px-5 py-4 reveal', `stagger-${Math.min(i + 1, 6)}`]}>
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-gold to-gold-light flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-warm-dark font-medium">{item}</span>
          </div>
        ))}
      </div>

      <!-- Transparency note -->
      <div class="max-w-2xl mx-auto text-center reveal">
        <div class="bg-white rounded-2xl p-8 border border-gold-light/30">
          <svg class="w-10 h-10 text-gold mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <p class="font-cormorant text-xl italic text-warm-dark leading-relaxed">
            If additional time is needed beyond our estimate, you will always be informed before continuing.
          </p>
          <p class="text-warm mt-3 text-sm">
            No surprises. Full transparency. Always.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <CTASection
    headline="Ready to Get Started?"
    subtext="Your free consultation is just one click away."
    buttonText="Book My Free Consultation"
    buttonHref="/contact#contact-form"
    variant="warm"
  />

</Layout>
